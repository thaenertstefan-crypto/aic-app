{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Die reinen Parser-Module (lib/anthropic/*-result.ts, model-json.ts) laufen
    // unter `npm test` direkt in Node per Type-Stripping. Node löst in ESM keine
    // Endungen auf, deshalb importieren sie einander mit explizitem ".ts".
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    // Bewusst aus. `next build` legt den Inkrement-Stand unter
    // `.next/cache/.tsbuildinfo` ab — und genau `.next/cache` stellt Vercel vor
    // jedem Build als Cache wieder her. Trifft ein wiederhergestellter Stand auf
    // einen Commit, der Module gelöscht hat (die Refactor-Runde KAN-25 ff.),
    // frisst der Typcheck den Speicher des Builders auf und stirbt mit SIGKILL:
    // grün lokal, rot auf Vercel, ohne Fehlermeldung. Der volle Check kostet
    // rund 10 s — billiger als ein Deploy, der aus einem fremden Cache heraus
    // kaputtgeht.
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
